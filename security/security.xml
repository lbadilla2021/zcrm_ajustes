<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="crm_recorrido_rule_company" model="ir.rule">
            <field name="name">Recorridos: multiempresa</field>
            <field name="model_id" ref="model_crm_recorrido"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="crm_visita_rule_company" model="ir.rule">
            <field name="name">Visitas: multiempresa</field>
            <field name="model_id" ref="model_crm_visita"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="crm_recorrido_rule_own" model="ir.rule">
            <field name="name">Recorridos: vendedor propio</field>
            <field name="model_id" ref="model_crm_recorrido"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <record id="crm_visita_rule_own" model="ir.rule">
            <field name="name">Visitas: vendedor propio</field>
            <field name="model_id" ref="model_crm_visita"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <record id="crm_recorrido_rule_manager" model="ir.rule">
            <field name="name">Recorridos: jefe comercial</field>
            <field name="model_id" ref="model_crm_recorrido"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        </record>

        <record id="crm_visita_rule_manager" model="ir.rule">
            <field name="name">Visitas: jefe comercial</field>
            <field name="model_id" ref="model_crm_visita"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        </record>
    </data>
</odoo>
