<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_recorridos" model="ir.ui.view">
        <field name="name">crm.lead.form.recorridos</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_field_visits" type="object"
                        class="oe_stat_button" icon="fa-map-marker"
                        invisible="visit_count == 0">
                    <field name="visit_count" widget="statinfo" string="Visitas"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
